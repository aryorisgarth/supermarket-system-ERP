# URL del API (desarrollo local)
VITE_API_URL=http://localhost:8082/api

# Producción con Docker (nginx hace proxy a /api)
# VITE_API_URL=/api

# Clave PÚBLICA de Stripe (Dashboard → Developers → API keys → Publishable key)
# Debe ser del MISMO modo (test/live) que STRIPE_SECRET_KEY del backend.
VITE_STRIPE_PUBLIC_KEY=pk_test_reemplaza_con_tu_clave
# Keycloak (Docker local usa prefijo /auth)
VITE_KEYCLOAK_URL=http://localhost:8080/auth
VITE_KEYCLOAK_REALM=supermarket
VITE_KEYCLOAK_CLIENT_ID=supermarket-app
