# ====================================================================
# Variables de entorno — Sistema Supermercado
# ====================================================================
# Desarrollo (Windows):
#   cp .env.example .env
#   docker compose up -d --build
#
# Producción (AWS EC2):
#   cp .env.example .env.prod
#   # editar secretos reales en .env.prod
#   cd 03-FRONTEND && npm run build && cd ..
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Nunca subas .env / .env.local / .env.prod al repositorio.
# ====================================================================

# --- Base de datos ---
DB_PASSWORD=mysql
DB_USERNAME=root
# Solo necesario si corres la API fuera de Docker (IDE / mvn spring-boot:run):
# DEV local Docker usa mysql:3306 dentro de la red compose.
# PROD AWS usa host.docker.internal:3306 (MySQL en el host EC2).
# DB_URL=jdbc:mysql://localhost:3306/supermarket_system

# --- Seguridad JWT ---
JWT_SECRET=dev-docker-jwt-secret-minimo-32-caracteres-2026
JWT_EXPIRATION_MS=86400000

# --- Keycloak ---
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_SECRET=nngpFPrXQqq9aRPwa0OVMsWuGCmOuUvV
KEYCLOAK_CLIENT_ID=supermarket-app
KEYCLOAK_REALM=supermarket
KEYCLOAK_ADMIN_CLIENT_ID=supermarket-admin-client

# --- Pagos (Stripe / MOCK) ---
PAYMENT_GATEWAY_PROVIDER=MOCK
PAYMENT_GATEWAY_ENABLED=true
STRIPE_SECRET_KEY=sk_test_reemplaza_con_tu_clave_secreta
# Clave pública (se inyecta al build del frontend Docker)
VITE_STRIPE_PUBLIC_KEY=pk_test_reemplaza_con_tu_clave_publica

# --- Facturación / país ---
BILLING_COUNTRY=NI
PAYMENT_CURRENCY=NIO
ISSUER_TAX_ID=J0310000000001
ELECTRONIC_INVOICE_ENABLED=true

# --- Seed / esquema ---
SEED_ENABLED=true
DDL_AUTO=validate

# --- Correo (alertas) ---
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Equivalentes Spring Boot (si corres API fuera de compose):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS_ENABLE=true

# --- Observabilidad (solo desarrollo local) ---
GRAFANA_ADMIN_PASSWORD=admin

# --- CORS (sobrescribir si despliegas con dominio público) ---
# CORS_ALLOWED_ORIGINS=https://tu-dominio.com,http://localhost
